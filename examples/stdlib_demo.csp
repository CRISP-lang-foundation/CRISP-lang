say "pid() → " + pid();
say "system('echo', 'hello from system') → ";
let exit_code = system("echo", "  hello from system");
say "  exit code: " + exit_code;
say "";

say "qx() — capture command output:";
let date_output = qx("date");
say "  qx('date') → " + date_output;
say "";

# -----------------------------------------------------------------
# File I/O
# -----------------------------------------------------------------
say "--- File I/O ------------------------------------------------";
